generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Enums : 
enum MealsStatus {
  AVAILABLE
  STOCKOUT
}

enum OrdersStatus {
  PLACED
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

enum Role {
  ADMIN
  USER
  PROVIDER
}

enum UserStatus {
  ACTIVATE
  SUSPEND
}

enum ComplaintCategory {
  FOOD_QUALITY
  MISSING_ITEMS
  LATE_DELIVERY
  WRONG_ORDER
  OTHER
}

enum ComplaintStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
}

enum PaymentMethod {
  COD
  SSLCOMMERZ
  STRIPE
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  CANCELLED
}

enum DiscountType {
  PERCENT
  FLAT
}

model Coupon {
  id           String       @id @default(uuid())
  code         String       @unique
  discountType DiscountType
  value        Int
  maxDiscount  Int?
  minOrder     Int          @default(0)
  maxUses      Int?
  usedCount    Int          @default(0)
  active       Boolean      @default(true)
  expiresAt    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Complaint {
  id          String            @id @default(uuid())
  orderId     String
  userId      String
  providerId  String
  category    ComplaintCategory @default(OTHER)
  description String
  status      ComplaintStatus   @default(OPEN)
  resolution  String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model Meals {
  id          String           @id @default(uuid())
  name        String           @db.VarChar(225)
  categoryId  String
  category    Category         @relation(fields: [categoryId], references: [id])
  providerId  String
  provider    ProvidersProfile @relation(fields: [providerId], references: [id])
  price       Decimal
  quantity    Int
  image       String?
  description String
  status      MealsStatus      @default(AVAILABLE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  isOnDiet    Boolean
  reviews     Reviews[]
  orderItems  OrderItems[]
  isDeleted Boolean @default(false)
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique @db.VarChar(225)
  meals     Meals[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Orders {
  id             String            @id @default(uuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id])
  providerId     String?
  provider       ProvidersProfile? @relation(fields: [providerId], references: [id])
  totalPrice     Decimal // Stored in cents (e.g., 1000 for $10.00)
  address        String
  contactNumber  String            @db.VarChar(30)
  status         OrdersStatus      @default(PLACED) // Ensure you have a default
  paymentMethod  PaymentMethod     @default(COD)
  paymentStatus  PaymentStatus     @default(UNPAID)
  transactionId  String?
  deliveryCharge Int               @default(0)
  discount       Int               @default(0)
  couponCode     String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  orderItems     OrderItems[]

  @@index([status])
  @@index([userId]) // Added index for customer order history lookup
}

model OrderItems {
  id        String   @id @default(uuid())
  price     Decimal // Price at the time of purchase
  quantity  Int
  mealsId   String
  meals     Meals    @relation(fields: [mealsId], references: [id])
  orderId   String
  order     Orders   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Reviews {
  id        String   @id @default(uuid())
  ratings   Int
  userId    String
  mealsId   String
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  meals     Meals    @relation(fields: [mealsId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([ratings])
  @@map("reviews")
}

model ProvidersProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  name      String
  email     String
  latitude  Float?   // 👈 Restaurant er latitude
  longitude Float?   // 👈 Restaurant er longitude
  meals     Meals[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Orders[]
  isDeleted Boolean @default(false)
}

model User {
  id               String            @id
  name             String
  email            String            @unique
  emailVerified    Boolean           @default(false)
  phoneVerified    Boolean           @default(false)
  phoneOtp         String?
  phoneOtpExpires  DateTime?
  providersProfile ProvidersProfile?
  image            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  role             Role              @default(USER)
  phone            String?
  status           UserStatus        @default(ACTIVATE)
  accounts         Account[]
  sessions         Session[]
  orders           Orders[]
  reviews          Reviews[]
  loginHistories LoginHistory[]
  isDeleted Boolean @default(false)

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt





  @@index([identifier])
  @@map("verification")
}



model LoginHistory {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String?  
  device    String?  
  loginAt   DateTime @default(now())
}